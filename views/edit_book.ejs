<!DOCTYPE html>
<html>
<head><title>Edit Book</title></head>
<body style="font-family: Arial; margin: 30px;">
    <h2>Edit Book</h2>
    <form action="/book/edit/<%= book.book_id %>" method="POST">
        <label>Title:</label><br><input type="text" name="title" value="<%= book.title %>" required><br><br>
        <label>Price:</label><br><input type="number" step="0.01" name="price" value="<%= book.price %>" required><br><br>
        <label>Author:</label><br>
        <select name="author_id" required>
            <% authors.forEach(author => { %>
                <option value="<%= author.author_id %>" <%= author.author_id === book.author_id ? 'selected' : '' %>><%= author.name %></option>
            <% }) %>
        </select><br><br>
        <button type="submit">Update Book</button>
    </form>
    <br><a href="/dashboard">Back to Dashboard</a>
</body>
</html>