<!DOCTYPE html>
<html>
<head><title>Add Book</title></head>
<body style="font-family: Arial; margin: 30px;">
    <h2>Add New Book</h2>
    <form action="/book/add" method="POST">
        <label>Book ID:</label><br><input type="number" name="book_id" required><br><br>
        <label>Title:</label><br><input type="text" name="title" required><br><br>
        <label>Price:</label><br><input type="number" step="0.01" name="price" required><br><br>
        <label>Author:</label><br>
        <select name="author_id" required>
            <% authors.forEach(author => { %>
                <option value="<%= author.author_id %>"><%= author.name %> (ID: <%= author.author_id %>)</option>
            <% }) %>
        </select><br><br>
        <button type="submit">Save Book</button>
    </form>
    <br><a href="/dashboard">Back to Dashboard</a>
</body>
</html>